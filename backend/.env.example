# Copy to backend/.env and fill in the values. Never commit the real .env.
# Every variable the backend reads is listed here; backend/DEPLOYMENT.md has the full table.

# Server
# "production" hides error details, logs in combined format and refuses to start without JWT_SECRET or DAILY_SEED_SECRET
NODE_ENV=development
# Port the API listens on (default 3000; production uses 5439 behind nginx)
PORT=3000
# Allowed CORS origin (default http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Host (default localhost)
DB_HOST=localhost
# Port (default 5432)
DB_PORT=5432
# Database name (default sea_invaders)
DB_NAME=sea_invaders
# Role that owns the database (default sea_invaders_user)
DB_USER=sea_invaders_user
# Password of that role (required)
DB_PASSWORD=your_database_password_here

# Signs the session JWTs; at least 32 characters, generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_use_64_char_random_string

# Rate limiting of /api/*: window in ms (default 900000 = 15 min)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per client (default 3000)
RATE_LIMIT_MAX_REQUESTS=3000

# Daily ranked run
# Secret behind the daily seed (HMAC); at least 32 characters, generate with: openssl rand -hex 32
DAILY_SEED_SECRET=your_64_char_random_string
# Free attempts per UTC day, on top of any on-chain ticket bought for today (default 0; keep 0 in production)
DAILY_FREE_ATTEMPTS=0

# Sign-In With Solana: the domain and uri the wallet shows and the server checks
# Domain (default seainvaders.xyz)
AUTH_DOMAIN=seainvaders.xyz
# URI (default https://seainvaders.xyz)
AUTH_URI=https://seainvaders.xyz

# Jupiter swap API key (server-side only, sent as the x-api-key header); swap quotes exist only on mainnet
JUPITER_API_KEY=

# Helius (server-side only): the mainnet read behind the Seeker Genesis Token check.
# Without this key POST /api/seeker/link answers 503; the key is never returned to clients.
HELIUS_API_KEY=
# Optional override of the endpoint the check calls (defaults to Helius's mainnet RPC with the key above)
# HELIUS_MAINNET_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# On-chain (devnet today)
# "devnet" or "mainnet" (default devnet); the devnet faucet route exists only on devnet
SOLANA_CLUSTER=devnet
# RPC endpoint for every chain read and write (required)
SOLANA_RPC_URL=https://api.devnet.solana.com
# sea_invaders program id (devnet)
PROGRAM_ID=G1vEN2CY1KfjPia3hD7MALBwseSRUfrcBivxfKKGqset
# SKR token mint (devnet test mint)
SKR_MINT=Bk454WdhpYQB2crEQeVNQWWqi33xqFWXELHbi44XkHht
# PRIVATE KEY - never commit it. Base58 of the server authority's 64-byte Solana secret key: co-signs records
# and Seeker links, pays the weekly crank's fees and mints the devnet faucet's test SKR. The deployment's own key
# is not published, and this placeholder is refused at startup: replace it before `npm run dev`. For a local
# run, generate a throwaway key from backend/ with:
#   node -e "const{Keypair}=require('@solana/web3.js');console.log(require('bs58').default.encode(Keypair.generate().secretKey))"
SERVER_AUTHORITY_SECRET=replace_with_base58_of_a_64_byte_secret_key
# Devnet faucet: SOL the server authority keeps for the crank and settlement; below it the faucet shuts (default 0.5)
FAUCET_MIN_SOL=0.5
