# Discord OAuth Configuration
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=https://yourdomain.com/api/auth/discord/callback

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_use_64_char_random_string

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sea_invaders
DB_USER=sea_invaders_user
DB_PASSWORD=your_database_password_here

# Redis Configuration (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_MAX_DURATION=3600000
SESSION_HEARTBEAT_TIMEOUT=30000

# Leaderboard Configuration
LEADERBOARD_CACHE_TTL=30
LEADERBOARD_MAX_ENTRIES=100

# Anti-Cheat Configuration
ENABLE_SCORE_VALIDATION=true
MAX_SCORE_PER_LEVEL=10000
MAX_LEVEL=100
MIN_GAME_DURATION=5000
