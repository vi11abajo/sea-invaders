{
  "name": "sea-invaders-backend",
  "version": "1.0.0",
  "description": "Sea Invaders API - wallet sign-in, ranked runs and replay verification, on-chain transactions, the weekly crank",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node migrations/run.js",
    "crank": "node src/jobs/weekly.js",
    "build:core": "npm --prefix ../core run build",
    "pretest": "npm run build:core",
    "test": "vitest run"
  },
  "keywords": [
    "sea-invaders",
    "game",
    "leaderboard"
  ],
  "author": "vi11abajo",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@sea-invaders/core": "file:../core",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-util": "^1.1.4",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "supertest": "7.2.2",
    "vitest": "4.1.9"
  }
}
