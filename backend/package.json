{
  "name": "sea-invaders-backend",
  "version": "1.0.0",
  "description": "Sea Invaders backend - auth, game sessions, leaderboards and tournaments",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node migrations/run.js",
    "build:core": "npm --prefix ../core run build",
    "pretest": "npm run build:core",
    "test": "vitest run"
  },
  "keywords": ["sea-invaders", "game", "leaderboard", "discord", "oauth"],
  "author": "vi11abajo",
  "license": "MIT",
  "dependencies": {
    "@sea-invaders/core": "file:../core",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "node-cache": "^5.1.2",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "supertest": "7.2.2",
    "vitest": "4.1.9"
  }
}
