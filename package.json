{
  "name": "sea-invaders",
  "version": "2.0.0",
  "description": "Sea Invaders - arcade shooter: defend the reef from waves of crabs and their bosses",
  "main": "game-config.js",
  "scripts": {
    "dev": "next dev",
    "dev:vite": "vite",
    "build": "next build",
    "build:vite": "npm run build:main && npm run build:tournament",
    "build:main": "cross-env vite build",
    "build:tournament": "cross-env BUILD_TARGET=tournament vite build",
    "build:watch": "vite build --watch",
    "start": "next start",
    "preview": "vite preview",
    "deploy": "bash deploy.sh",
    "lint": "next lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vi11abajo/sea-invaders.git"
  },
  "keywords": [
    "sea-invaders",
    "arcade",
    "shooter",
    "game"
  ],
  "author": "vi11abajo",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vi11abajo/sea-invaders/issues"
  },
  "homepage": "https://github.com/vi11abajo/sea-invaders#readme",
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.1.4",
    "pg": "^8.11.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "socket.io-client": "^4.6.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "cross-env": "^10.1.0",
    "sharp-cli": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.8"
  }
}
