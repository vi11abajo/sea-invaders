# Copy to mobile/.env before building. Values are public and inlined into the APK.
# The dev machine's LAN address, reachable from the phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Production API, use instead of the LAN address when not pointing at a local backend:
# EXPO_PUBLIC_API_URL=https://api.seainvaders.xyz
# Solana RPC endpoint used for reads/writes from the app.
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
# "devnet" or "mainnet"; devnet only in this phase.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
